{
  "name": "mini-docker-presentation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "slides:dev": "vite presentation --host 127.0.0.1",
    "slides:build": "vite build presentation --outDir ../dist/presentation",
