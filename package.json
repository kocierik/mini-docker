    "slides:pdf": "node presentation/scripts/export-pdf.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans-condensed": "5.2.8",
    "reveal.js": "6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "vite": "8.1.5"
  }
}